# SECURECODE — Environment Variables Template (.env)
# Copy to .env and configure for your environment
# NEVER commit .env file with real secrets!

# ===== DATABASE =====
DATABASE_URL=
DATABASE_POOL_SIZE=
DATABASE_POOL_TIMEOUT=
DATABASE_ECHO=

# ===== GITHUB API =====
GITHUB_TOKEN=
GITHUB_API_BASE_URL=
GITHUB_API_VERSION=
GITHUB_API_TIMEOUT_SECONDS=
GITHUB_API_MAX_RETRIES=

# ===== AUTHENTICATION (JWT) =====
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=

# ===== APPLICATION =====
APP_ENV=
APP_NAME=
APP_VERSION=
APP_DEBUG=
LOG_LEVEL=

# ===== ADMIN INITIAL USER =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== SECURITY =====
CORS_ORIGINS=
SECURE_COOKIES=

# ===== MONITORING =====
SENTRY_DSN=
PROMETHEUS_ENABLED=

# ===== RAILWAY (Production Only) =====
# DATABASE_URL (managed by Railway)
# GITHUB_TOKEN (Railway Secrets)
# JWT_SECRET_KEY (Railway Secrets)
