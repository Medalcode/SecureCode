# SECURECODE — Environment Variables Template (.env)
#
# INSTRUCCIONES:
#   cp .env.example .env
#   Editar .env con valores reales para tu entorno.
#   NUNCA commitear el archivo .env — está en .gitignore.
#
# Para producción (Google Cloud Run) utiliza Secret Manager:
#   gcloud secrets create securecode-jwt-secret --replication-policy="automatic"
#   echo -n "$(python -c 'import secrets; print(secrets.token_hex(32))')" | \
#     gcloud secrets versions add securecode-jwt-secret --data-file=-

# ===== BASE DE DATOS =====
# Local con Docker Compose (apunta al servicio 'db' definido en docker-compose.yml):
#   DATABASE_URL=postgresql://securecode:CHANGE_ME@db:5432/securecode
# Supabase / Cloud PostgreSQL (Transaction Pooler, puerto 6543, SSL obligatorio):
#   DATABASE_URL=postgresql://user:CHANGE_ME@db.xxxx.supabase.co:6543/postgres?sslmode=require
DATABASE_URL=

# ===== POSTGRESQL — Sólo para docker-compose.yml local =====
POSTGRES_USER=securecode
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=securecode

# ===== GITHUB API =====
# Token con permisos mínimos: read:org, repo (sólo lectura)
GITHUB_TOKEN=

# ===== AUTENTICACIÓN JWT =====
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# Mínimo 32 caracteres aleatorios. En producción usa Secret Manager.
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== APLICACIÓN =====
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# ===== SEMILLERO DE USUARIO INICIAL =====
# Utilizado por scripts/seed_user.py en entornos automatizados (CI/CD, Cloud Run Jobs).
# No usar contraseñas predecibles. En producción inyectar desde Secret Manager.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
# Usar admin sólo para el primer operador confiable; el resto debe ser auditor.
SEED_USER_ROLE=admin

# ===== SEGURIDAD =====
# Lista de orígenes CORS permitidos (separados por coma).
CORS_ORIGINS=http://localhost:8000

# Orígenes permitidos para la UI. En producción define exclusivamente los dominios HTTPS
# reales, separados por coma; no uses '*'.
# Ejemplo: CORS_ORIGINS=https://securecode.example.com

# ===== MONITOREO (opcional) =====
# SENTRY_DSN=
# PROMETHEUS_ENABLED=false

# ===== GOOGLE CLOUD RUN (Producción) =====
# Las variables sensibles (DATABASE_URL, JWT_SECRET_KEY, GITHUB_TOKEN,
# SEED_USER_PASSWORD) deben inyectarse vía --set-secrets, NO --set-env-vars.
# Ver README.md § "Guía de Despliegue Seguro en Google Cloud Run".
