# SECURECODE — Environment Variables Template (.env)
# Copy to .env and configure for your environment
# NEVER commit .env file with real secrets!

# ===== DATABASE =====
DATABASE_URL=postgresql://securecode_user:password123@localhost:5432/securecode_dev
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ===== GITHUB API =====
GITHUB_API_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_API_TIMEOUT_SECONDS=30
GITHUB_API_MAX_RETRIES=3

# ===== AUTHENTICATION (JWT) =====
JWT_SECRET_KEY=your-super-secret-key-min-32-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== APPLICATION =====
APP_ENV=development
APP_NAME=SECURECODE
APP_VERSION=1.0.0
APP_DEBUG=true
LOG_LEVEL=DEBUG

# ===== ADMIN INITIAL USER =====
ADMIN_EMAIL=admin@securecode.local
ADMIN_PASSWORD=admin123

# ===== SECURITY =====
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
SECURE_COOKIES=false

# ===== MONITORING =====
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# ===== RAILWAY (Production Only) =====
# DATABASE_URL (managed by Railway)
# GITHUB_API_TOKEN (Railway Secrets)
# JWT_SECRET_KEY (Railway Secrets)
